# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local secrets and environment settings
.env
.env.*
!.env.example

# Local databases and logs
*.db
*.sqlite
*.sqlite3
*.log

# User uploads and generated inference output
uploads/*
!uploads/.gitkeep
x-ray/uploads/*
!x-ray/uploads/.gitkeep
x-ray/static/pred_images_dir/*
!x-ray/static/pred_images_dir/.gitkeep
x-ray/static/proc_images_dir/*
!x-ray/static/proc_images_dir/.gitkeep
x-ray/static/analysis_images_dir/*
!x-ray/static/analysis_images_dir/.gitkeep
x-ray/df_fin_preds.csv

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
